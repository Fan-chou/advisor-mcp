# Remote HTTP mode. Copy to .env and inject secrets through your deployment.
ADVISOR_TRANSPORT=http
ADVISOR_HTTP_HOST=0.0.0.0
ADVISOR_HTTP_PORT=8787
ADVISOR_HTTP_PATH=/mcp
ADVISOR_HTTP_TOKEN=replace-with-at-least-16-random-characters

ADVISOR_PROVIDER=openai-compatible
ADVISOR_MODEL=your-advisor-model
ADVISOR_API_KEY=your-provider-key
ADVISOR_BASE_URL=https://api.openai.com/v1

# Restrict browser origins and accepted Host headers in production.
# ADVISOR_HTTP_ALLOWED_ORIGINS=https://your-console.example
# ADVISOR_HTTP_ALLOWED_HOSTS=advisor.example.com

# Set to true only behind a trusted reverse proxy.
# ADVISOR_HTTP_TRUST_PROXY=true

# Server-side guards
ADVISOR_HTTP_MAX_BODY_BYTES=1048576
ADVISOR_HTTP_MAX_CONCURRENT_REQUESTS=8
ADVISOR_HTTP_REQUESTS_PER_MINUTE=120
# Keep false unless requests really arrive through a trusted reverse proxy.
ADVISOR_HTTP_TRUST_PROXY=false
ADVISOR_MAX_CALLS_PER_SESSION=12
ADVISOR_MAX_CALLS_PER_MINUTE=30

# Persistent session state across restarts
ADVISOR_STORE=file
ADVISOR_DATA_DIR=/data
