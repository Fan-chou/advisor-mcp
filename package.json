{
  "name": "advisor-mcp",
  "version": "0.1.0",
  "description": "A model-agnostic MCP advisor for coding agents.",
  "type": "module",
  "bin": {
    "advisor-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "dev:http": "ADVISOR_TRANSPORT=http tsx src/index.ts",
    "start": "node dist/index.js",
    "start:http": "ADVISOR_TRANSPORT=http node dist/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20.18"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fan-chou/advisor-mcp.git"
  }
}
