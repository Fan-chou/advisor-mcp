# Provider: "openai-compatible" or "anthropic"
ADVISOR_PROVIDER=openai-compatible
ADVISOR_MODEL=your-model-id

# ADVISOR_API_KEY takes precedence. These conventional variables also work:
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...
ADVISOR_API_KEY=

# Optional endpoint overrides. Use your provider's OpenAI-compatible endpoint.
# ADVISOR_BASE_URL=https://api.openai.com/v1
# ADVISOR_BASE_URL=http://127.0.0.1:11434/v1

# Optional limits
# ADVISOR_MAX_OUTPUT_TOKENS=1200
# ADVISOR_TOKEN_PARAM=max_completion_tokens
# ADVISOR_TIMEOUT_MS=60000
# ADVISOR_MAX_CONTEXT_CHARS=120000
# ADVISOR_MAX_CALLS_PER_SESSION=12
# ADVISOR_MAX_CALLS_PER_MINUTE=30
# ADVISOR_STYLE=brief

# Use "file" to persist sessions across MCP server restarts.
# ADVISOR_STORE=memory
# ADVISOR_DATA_DIR=~/.advisor-mcp

# Remote HTTP mode (see .env.http.example)
# ADVISOR_TRANSPORT=stdio
# ADVISOR_HTTP_HOST=127.0.0.1
# ADVISOR_HTTP_PORT=8787
# ADVISOR_HTTP_PATH=/mcp
# ADVISOR_HTTP_TOKEN=
# ADVISOR_HTTP_ALLOW_UNAUTHENTICATED_LOOPBACK=false
# ADVISOR_HTTP_ALLOWED_ORIGINS=
# ADVISOR_HTTP_ALLOWED_HOSTS=
# ADVISOR_HTTP_MAX_BODY_BYTES=1048576
# ADVISOR_HTTP_MAX_CONCURRENT_REQUESTS=8
# ADVISOR_HTTP_REQUESTS_PER_MINUTE=120
# ADVISOR_HTTP_TRUST_PROXY=false
